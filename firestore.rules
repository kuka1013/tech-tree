rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
    
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }

    function isValidTreeData(data) {
      return data.keys().hasAll(['nodes', 'edges', 'ownerId']) 
        && data.keys().size() == 3
        && data.nodes is string
        && data.edges is string
        && data.ownerId is string
        && data.ownerId == request.auth.uid;
    }

    match /trees/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && isValidId(userId) && request.auth.uid == userId && isValidTreeData(incoming());
      allow update: if isSignedIn() && isValidId(userId) && request.auth.uid == userId 
        && isValidTreeData(incoming()) 
        && incoming().ownerId == existing().ownerId
        && incoming().diff(existing()).affectedKeys().hasOnly(['nodes', 'edges']);
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    match /trees/devs_shared {
      allow read, write: if true;
    }
  }
}
